# ==============================================================================
# UNDANGAN DIGITAL — ENVIRONMENT TEMPLATE
# Salin menjadi `.env` untuk development lokal. Jangan commit `.env`.
# ==============================================================================

# APP
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3002

# DATABASE POSTGRESQL
DATABASE_URL="postgresql://undangan_user:ganti-password@127.0.0.1:5432/undangan_dev?schema=public"

# AUTH ADMIN (Google via Hallo SPTP)
# Minimal 32 karakter acak. Generate: openssl rand -base64 48
AUTH_SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# WEBHOOK n8n (opsional)
N8N_WEBHOOK_URL=""
N8N_WEBHOOK_SECRET=""
